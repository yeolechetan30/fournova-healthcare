{
  "$schema": "https://vercel.com",
  "version": 2,
  "outputDirectory": "dist/FourNova-Healthcare/browser",
  "cleanUrls": true,
  "routes": [
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/google97a22dc9081d2482.html",
      "dest": "/google97a22dc9081d2482.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
