{
  "$schema": "https://vercel.com",
  "version": 2,
  "outputDirectory": "dist/FourNova-Healthcare/browser",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/public/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/public/robots.txt"
    },
    {
      "source": "/google97a22dc9081d2482.html",
      "destination": "/google97a22dc9081d2482.html"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}