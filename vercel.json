{
  "$schema": "https://vercel.com",
  "version": 2,
  "outputDirectory": "dist/FourNova-Healthcare/browser",
  "cleanUrls": true,
  "routes": [
    {
      "src": "/(sitemap\\.xml|robots\\.txt|google97a22dc9081d2482\\.html)",
      "continue": true,
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate" }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ]
}
